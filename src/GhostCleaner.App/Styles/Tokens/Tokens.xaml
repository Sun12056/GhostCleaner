<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         GhostCleaner Design Tokens — 与主题无关的部分
         对应 docs/ui-0.1/07-DesignTokens.md
         颜色 token 见 Theme.Light.xaml / Theme.Dark.xaml
         说明：为避免依赖 sys:Double 程序集映射，字号/控件高度等标量
               直接以字面量写在各 Style 中（每处仅定义一次）。
         ============================================================ -->

    <!-- ========== 字体 ========== -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Font.UIText">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Cascadia Code, Consolas, Microsoft YaHei Mono, Consolas</FontFamily>

    <!-- ========== 圆角 ========== -->
    <CornerRadius x:Key="Radius.XS">4</CornerRadius>
    <CornerRadius x:Key="Radius.SM">6</CornerRadius>
    <CornerRadius x:Key="Radius.MD">8</CornerRadius>
    <CornerRadius x:Key="Radius.LG">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- ========== 间距（8px 网格） ========== -->
    <Thickness x:Key="Space.1">4</Thickness>
    <Thickness x:Key="Space.2">8</Thickness>
    <Thickness x:Key="Space.3">12</Thickness>
    <Thickness x:Key="Space.4">16</Thickness>
    <Thickness x:Key="Space.5">20</Thickness>
    <Thickness x:Key="Space.6">24</Thickness>
    <Thickness x:Key="Space.8">32</Thickness>
    <Thickness x:Key="Space.10">40</Thickness>
    <Thickness x:Key="Space.12">48</Thickness>
    <Thickness x:Key="Space.16">64</Thickness>

    <!-- ========== 描边 ========== -->
    <Thickness x:Key="Border.Width.Default">1</Thickness>
    <Thickness x:Key="Border.Width.Strong">2</Thickness>
    <Thickness x:Key="Border.Width.AccentLeft">3,0,0,0</Thickness>
    <Thickness x:Key="Border.Width.RuleBottom">0,0,0,1</Thickness>
    <Thickness x:Key="Border.Width.RuleTop">0,1,0,0</Thickness>

    <!-- ========== 页面 / 卡片 ========== -->
    <Thickness x:Key="Layout.PagePadding">32,24,32,48</Thickness>
    <Thickness x:Key="Layout.CardPadding">20</Thickness>
    <Thickness x:Key="Layout.CardFootPadding">12,16,12,16</Thickness>
    <Thickness x:Key="Layout.ContentPadding">16</Thickness>

    <!-- ========== 动效时长 ========== -->
    <Duration x:Key="Duration.Fast">0:0:0.12</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.20</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.32</Duration>

</ResourceDictionary>
