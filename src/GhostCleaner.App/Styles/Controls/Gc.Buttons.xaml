<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Button / IconButton
         规范：docs/ui-0.1/09-组件规范.md §1 §2
         高度 32（sm 28 / lg 40）· 圆角 6 · 字号 14 · 无阴影
         颜色全部使用 DynamicResource，保证运行时切换主题立即生效
         ============================================================ -->

    <!-- ========== 基类 ========== -->
    <Style x:Key="GcButtonBase" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.SM}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Secondary（默认） ========== -->
    <Style x:Key="GcButton" TargetType="Button" BasedOn="{StaticResource GcButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Primary ========== -->
    <Style x:Key="GcButton.Primary" TargetType="Button" BasedOn="{StaticResource GcButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Focus}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Subtle ========== -->
    <Style x:Key="GcButton.Subtle" TargetType="Button" BasedOn="{StaticResource GcButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Danger（实心，仅用于最终确认按钮） ========== -->
    <Style x:Key="GcButton.Danger" TargetType="Button" BasedOn="{StaticResource GcButtonBase}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== Danger Subtle（列表里的危险操作） ========== -->
    <Style x:Key="GcButton.DangerSubtle" TargetType="Button" BasedOn="{StaticResource GcButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Fg}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ========== 尺寸变体 ========== -->
    <Style x:Key="GcButton.SM" TargetType="Button" BasedOn="{StaticResource GcButton}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="GcButton.Primary.SM" TargetType="Button" BasedOn="{StaticResource GcButton.Primary}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="GcButton.Subtle.SM" TargetType="Button" BasedOn="{StaticResource GcButton.Subtle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="GcButton.Subtle.LG" TargetType="Button" BasedOn="{StaticResource GcButton.Subtle}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="24,0" />
    </Style>
    <Style x:Key="GcButton.DangerSubtle.SM" TargetType="Button" BasedOn="{StaticResource GcButton.DangerSubtle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style x:Key="GcButton.LG" TargetType="Button" BasedOn="{StaticResource GcButton}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,0" />
    </Style>
    <Style x:Key="GcButton.Primary.LG" TargetType="Button" BasedOn="{StaticResource GcButton.Primary}">
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="24,0" />
    </Style>

    <!-- ============================================================
         IconButton —— 32×32（sm 28）
         ============================================================ -->
    <Style x:Key="GcIconButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.SM}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Bg.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GcIconButton.SM" TargetType="ButtonBase" BasedOn="{StaticResource GcIconButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
    </Style>

    <Style x:Key="GcIconButton.Bordered" TargetType="ButtonBase" BasedOn="{StaticResource GcIconButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SM}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GcIconButton.Danger" TargetType="ButtonBase" BasedOn="{StaticResource GcIconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Fg}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
