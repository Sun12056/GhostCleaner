<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:GhostCleaner.App.Converters">

    <!-- ============================================================
         Card / Badge / 文本层级 / Progress / ScrollBar / ToolTip
         规范：docs/ui-0.1/09-组件规范.md §3 §5 §14 §24
         关键约束：卡片用 1px 边框，不用阴影（V3）
         ============================================================ -->

    <converters:PercentToDashArrayConverter x:Key="PercentToDashArray" />
    <converters:PercentToWidthConverter x:Key="PercentToWidth" />

    <!-- ============================================================
         Card
         ============================================================ -->
    <Style x:Key="GcCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.MD}" />
        <Setter Property="Padding" Value="{StaticResource Layout.CardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="GcCard.Flush" TargetType="Border" BasedOn="{StaticResource GcCard}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 内嵌区（比表面更沉） -->
    <Style x:Key="GcSunken" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ============================================================
         Badge / RiskBadge —— 20 高，圆角 pill，必带图标 + 文字
         ============================================================ -->
    <Style x:Key="GcBadge" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <Style x:Key="GcBadge.Accent" TargetType="Border" BasedOn="{StaticResource GcBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
    </Style>
    <Style x:Key="GcBadge.Success" TargetType="Border" BasedOn="{StaticResource GcBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Success.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Success.Border}" />
    </Style>
    <Style x:Key="GcBadge.Warning" TargetType="Border" BasedOn="{StaticResource GcBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
    </Style>
    <Style x:Key="GcBadge.Danger" TargetType="Border" BasedOn="{StaticResource GcBadge}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
    </Style>

    <!-- 徽章内文字（与徽章配套使用） -->
    <Style x:Key="GcBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style x:Key="GcBadgeText.Accent" TargetType="TextBlock" BasedOn="{StaticResource GcBadgeText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Fg}" />
    </Style>
    <Style x:Key="GcBadgeText.Success" TargetType="TextBlock" BasedOn="{StaticResource GcBadgeText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Success.Fg}" />
    </Style>
    <Style x:Key="GcBadgeText.Warning" TargetType="TextBlock" BasedOn="{StaticResource GcBadgeText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning.Fg}" />
    </Style>
    <Style x:Key="GcBadgeText.Danger" TargetType="TextBlock" BasedOn="{StaticResource GcBadgeText}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger.Fg}" />
    </Style>

    <!-- ============================================================
         文本层级
         ============================================================ -->
    <Style x:Key="GcPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="GcPageSub" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="720" />
    </Style>
    <Style x:Key="GcH2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="GcH3" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="GcBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="GcBody.Secondary" TargetType="TextBlock" BasedOn="{StaticResource GcBody}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GcCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GcOverline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    </Style>
    <Style x:Key="GcMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="GcMetric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style x:Key="GcMetricLG" TargetType="TextBlock" BasedOn="{StaticResource GcMetric}">
        <Setter Property="FontSize" Value="36" />
    </Style>

    <!-- 全局默认文字颜色，避免任何地方出现黑色硬编码 -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>

    <!-- ============================================================
         ProgressBar（6px 细条）
         ============================================================ -->
    <Style x:Key="GcProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Confidence.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>

    <!-- 扫描进度环：88×88，轨道 6px -->
    <Style x:Key="GcScanRing" TargetType="ProgressBar">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid Width="88" Height="88">
                        <Ellipse Width="76" Height="76"
                                 Stroke="{DynamicResource Brush.Confidence.Track}"
                                 StrokeThickness="6"
                                 Fill="Transparent" />
                        <Ellipse x:Name="RingArc" Width="76" Height="76"
                                 Stroke="{DynamicResource Brush.Accent}"
                                 StrokeThickness="6"
                                 Fill="Transparent"
                                 StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                 StrokeDashArray="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PercentToDashArray}, ConverterParameter=238.76}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="RingRotation" Angle="-90" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 不确定进度（UDR-03 未就绪时的降级态）：显示旋转的短弧 -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="RingArc" Property="StrokeDashArray" Value="48,238.76" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RingSpin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RingRotation"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="-90" To="270"
                                                         Duration="0:0:1.4"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RingSpin" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 置信度条：宽 96 / 高 4（大号 160 / 6） -->
    <Style x:Key="GcConfidenceTrack" TargetType="Border">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Confidence.Track}" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GcConfidenceTrack.LG" TargetType="Border" BasedOn="{StaticResource GcConfidenceTrack}">
        <Setter Property="Width" Value="160" />
        <Setter Property="Height" Value="6" />
    </Style>

    <!-- ============================================================
         ScrollBar
         ============================================================ -->
    <Style x:Key="GcScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GcScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Background="{DynamicResource Brush.Border.Strong}"
                            CornerRadius="3"
                            Opacity="0.55" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="GcScrollBarVertical" TargetType="ScrollBar">
        <Grid Background="Transparent" Width="10">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource GcScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource GcScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GcScrollBarThumb}" Margin="3,0" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="GcScrollBarHorizontal" TargetType="ScrollBar">
        <Grid Background="Transparent" Height="10">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource GcScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource GcScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource GcScrollBarThumb}" Margin="0,3" />
                </Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="GcScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template" Value="{StaticResource GcScrollBarVertical}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template" Value="{StaticResource GcScrollBarHorizontal}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource GcScrollBar}" />

    <!-- ============================================================
         ToolTip
         ============================================================ -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.UIText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.SM}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         分隔线
         ============================================================ -->
    <Style x:Key="GcSeparator" TargetType="Separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Banner（警告 / 危险 / 信息）—— 规范 §11
         ============================================================ -->
    <Style x:Key="GcBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.SM}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.Warning.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning.Border}" />
    </Style>
    <Style x:Key="GcBanner.Danger" TargetType="Border" BasedOn="{StaticResource GcBanner}">
        <Setter Property="Background" Value="{DynamicResource Brush.Danger.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger.Border}" />
    </Style>
    <Style x:Key="GcBanner.Info" TargetType="Border" BasedOn="{StaticResource GcBanner}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Border}" />
    </Style>

</ResourceDictionary>
