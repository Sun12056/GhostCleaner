<UserControl x:Class="GhostCleaner.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">

    <StackPanel>

        <!-- 页面标题 -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="关于" Style="{StaticResource GcPageTitle}" />
            <TextBlock Text="GhostCleaner 是一个专门分析 Windows 软件残留的工具。"
                       Style="{StaticResource GcPageSub}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 品牌卡 -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Viewbox Grid.Column="0" Width="48" Height="48">
                    <Grid Width="48" Height="48">
                        <Path Data="{StaticResource Icon.Brand.Outline}"
                              Stroke="{DynamicResource Brush.Accent}"
                              StrokeThickness="2.6" StrokeLineJoin="Round" Fill="Transparent" />
                        <Path Data="{StaticResource Icon.Brand.Ghost}"
                              Fill="{DynamicResource Brush.Accent}" />
                    </Grid>
                </Viewbox>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProductName}"
                               FontFamily="{StaticResource Font.UI}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding Tagline}" Style="{StaticResource GcBody.Secondary}" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Text="MIT License · .NET 8 / WPF"
                           Style="{StaticResource GcCaption}" />
            </Grid>
        </Border>

        <!-- 它不做什么 -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="它不做什么" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding NotDoPoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource Icon.Check}"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource Brush.Success}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource GcBody.Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 安全设计 -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="安全设计" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding SafetyPoints}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0"
                                      VerticalAlignment="Top"
                                      Data="{StaticResource Icon.Check}"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource Brush.Success}"
                                      StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource GcBody.Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 两个不同的问题 -->
        <Border Style="{StaticResource GcCard}">
            <StackPanel>
                <TextBlock Text="两个不同的问题" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,16" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 使用迹象强度 -->
                    <Border Grid.Column="0" Style="{StaticResource GcSunken}">
                        <StackPanel>
                            <TextBlock Text="未检测到使用迹象的强度" Style="{StaticResource GcOverline}" />
                            <TextBlock Text="它有多没被提到？这是推断，不是结论 —— 高分不等于可以清理。"
                                       Style="{StaticResource GcBody.Secondary}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource GcConfidenceTrack.LG}" VerticalAlignment="Center">
                                    <Border Width="147" Height="6"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Background="{DynamicResource Brush.Confidence.VHP}"
                                            HorizontalAlignment="Left" />
                                </Border>
                                <TextBlock Text="92%" FontSize="16" FontWeight="SemiBold" Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Confidence.Fg}" />
                            </StackPanel>

                            <TextBlock Text="单一靛蓝色相的强度，绝不出现绿 / 红。系统重装过的机器上，"
                                       Style="{StaticResource GcCaption}" Margin="0,8,0,0" />
                            <TextBlock Text="所有目录都会缺失关联，此时这个数字会失去区分度。"
                                       Style="{StaticResource GcCaption}" />
                        </StackPanel>
                    </Border>

                    <!-- 清理风险 -->
                    <Border Grid.Column="2" Style="{StaticResource GcSunken}">
                        <StackPanel>
                            <TextBlock Text="清理风险" Style="{StaticResource GcOverline}" />
                            <TextBlock Text="如果清理它，可能有多危险？残留度高 ≠ 可以清理。"
                                       Style="{StaticResource GcBody.Secondary}" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Style="{StaticResource GcBadge.Danger}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="{StaticResource Icon.AlertCircle}"
                                              Fill="Transparent"
                                              Stroke="{DynamicResource Brush.Danger.Fg}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                        <TextBlock Text="高" Style="{StaticResource GcBadgeText.Danger}" Margin="4,0,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="检测到用户配置与近期修改"
                                           Style="{StaticResource GcCaption}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="两者可以同时出现：非常像残留，但清理风险很高。"
                                       Style="{StaticResource GcCaption}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
