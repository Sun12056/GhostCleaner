<UserControl x:Class="GhostCleaner.App.Views.ScanCompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Margin="0,32,0,0" HorizontalAlignment="Center">

        <Path Width="48" Height="48" Stretch="Uniform"
              Data="{StaticResource Icon.CircleCheck}"
              Fill="Transparent" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

        <TextBlock Text="扫描完成" FontSize="24" FontWeight="SemiBold" Margin="0,16,0,0"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding StatusText}" Style="{StaticResource GcBody.Secondary}"
                   Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="620" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Text="检测到" FontSize="36" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="{Binding ResultCount}" FontSize="36" FontWeight="SemiBold" Margin="8,0,0,0"
                       Foreground="{DynamicResource Brush.Text.Primary}" />
            <TextBlock Text="个未发现系统关联的软件目录" FontSize="24" Margin="8,0,0,8" VerticalAlignment="Bottom"
                       Foreground="{DynamicResource Brush.Text.Secondary}" />
        </StackPanel>

        <TextBlock Text="「未发现系统关联」不等于「可以删除」—— 请逐项查看检测依据后再决定。"
                   Style="{StaticResource GcCaption}" Margin="0,8,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="620" />

        <!-- 统计组 -->
        <Grid Margin="0,32,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MinWidth="120">
                <TextBlock Text="{Binding ScannedDirectories}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="已检查目录" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" MinWidth="120">
                <TextBlock Text="{Binding RecentActivityCount}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="近 90 天有文件活动" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="4" MinWidth="120">
                <TextBlock Text="{Binding UninstallerCount}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="自带卸载器" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="6" MinWidth="120">
                <TextBlock Text="{Binding ProtectedCount}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="受保护/已排除" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- 扫描警告 -->
        <Border Style="{StaticResource GcBanner}" Margin="0,32,0,0" MaxWidth="640"
                Visibility="{Binding HasScanWarnings, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"
                      Data="{StaticResource Icon.AlertTriangle}"
                      Fill="Transparent" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="扫描不完整" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.Warning.Fg}" />
                    <ItemsControl ItemsSource="{Binding ScanWarnings}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
            <Button Style="{StaticResource GcButton.Primary.LG}"
                    Command="{Binding ViewResultsCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="查看扫描结果" />
                    <Path Width="16" Height="16" Stretch="Uniform" Margin="8,0,0,0"
                          Data="{StaticResource Icon.ArrowRight}"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GcButton.LG}" Margin="12,0,0,0"
                    Content="重新扫描" Command="{Binding RestartScanCommand}" />
            <Button Style="{StaticResource GcButton.Subtle.LG}" Margin="12,0,0,0"
                    Content="导出报告" Command="{Binding ExportCommand}" />
        </StackPanel>

    </StackPanel>
</UserControl>
