<UserControl x:Class="GhostCleaner.App.Views.ScanSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel>

        <!-- 页面标题 -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="残留扫描" Style="{StaticResource GcPageTitle}" />
            <TextBlock Text="选择扫描范围。扫描只读取目录信息与系统关联，不会修改或删除任何文件。"
                       Style="{StaticResource GcPageSub}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 权限提示：不阻断扫描，但必须说清真实后果（不是"偏保守"） -->
        <Border Style="{StaticResource GcBanner}" Margin="0,0,0,24"
                Visibility="{Binding HasElevationRisk, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"
                      Data="{StaticResource Icon.AlertTriangle}"
                      Fill="Transparent" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="未以管理员身份运行" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.Warning.Fg}" />
                    <TextBlock Text="{Binding ElevationWarningText}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                    <TextBlock Text="{Binding ElevationRestrictionText}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Warning.Fg}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource GcButton.SM}" VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Content="以管理员身份重启" Command="{Binding RestartAsAdminCommand}" />
            </Grid>
        </Border>

        <!-- 扫描范围 -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="扫描范围" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,12" />

                <TextBlock Text="磁盘" Style="{StaticResource GcOverline}" Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="240" Margin="0,0,12,12" Padding="12"
                                    CornerRadius="{StaticResource Radius.SM}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.Border.Default}"
                                    Background="{DynamicResource Brush.Bg.Surface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Root}" FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <Border Style="{StaticResource GcBadge}" Margin="8,0,0,0"
                                                    Visibility="{Binding IsSystemDrive, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="系统盘" Style="{StaticResource GcBadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Display}" FontSize="12" Margin="0,4,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="自定义目录" Style="{StaticResource GcOverline}" Margin="12,8,0,8" />

                <ItemsControl ItemsSource="{Binding CustomDirectories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Bg.Sunken}"
                                    CornerRadius="{StaticResource Radius.SM}"
                                    Padding="12,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform"
                                          Data="{StaticResource Icon.FolderOpen}"
                                          Fill="Transparent" Stroke="{DynamicResource Brush.Text.Secondary}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource GcMono}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource GcIconButton.SM}"
                                            Command="{Binding DataContext.RemoveCustomDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="移除">
                                        <Path Width="12" Height="12" Stretch="Uniform"
                                              Data="{StaticResource Icon.Close}"
                                              Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Style="{StaticResource GcTextBox}"
                             Text="{Binding CustomDirectoryInput, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Style="{StaticResource GcButton}" Margin="8,0,0,0"
                            Content="添加" Command="{Binding AddInputDirectoryCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource GcButton.Subtle}" Margin="8,0,0,0"
                            Content="添加常见安装目录" Command="{Binding AddCommonDirectoriesCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 扫描选项 -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="扫描选项" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,12" />

                <Grid Margin="0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="最大扫描层级" FontWeight="SemiBold" />
                        <TextBlock Text="从根路径向下探测的层数。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" Width="220" SelectedIndex="{Binding MaxScanDepthIndex}">
                        <ComboBoxItem Content="1 层" />
                        <ComboBoxItem Content="2 层（推荐）" />
                        <ComboBoxItem Content="3 层" />
                        <ComboBoxItem Content="4 层" />
                    </ComboBox>
                </Grid>
                <Separator Style="{StaticResource GcSeparator}" />

                <Grid Margin="0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="包含隐藏目录" FontWeight="SemiBold" />
                        <TextBlock Text="关闭时可避免误入系统目录。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ToggleButton HorizontalAlignment="Right" Style="{StaticResource GcSwitch}"
                                  IsChecked="{Binding IncludeHiddenDirectories}" />
                </Grid>
                <Separator Style="{StaticResource GcSeparator}" />

                <Grid Margin="0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="软件判定阈值" FontWeight="SemiBold" />
                        <TextBlock Text="判定为“像软件目录”的最低分值。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" Width="220" SelectedIndex="{Binding MinSoftwareScoreIndex}">
                        <ComboBoxItem Content="20（宽松）" />
                        <ComboBoxItem Content="35" />
                        <ComboBoxItem Content="50（推荐）" />
                        <ComboBoxItem Content="70（严格）" />
                    </ComboBox>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 底部：口径说明 + 开始扫描 -->
        <Border Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1"
                CornerRadius="{StaticResource Radius.MD}" Padding="16">
            <Grid>
                <TextBlock Text="盘符根与 Program Files 等容器目录只取一级子目录；白名单路径与保留关键词会自动跳过。"
                           Style="{StaticResource GcCaption}" VerticalAlignment="Center" MaxWidth="620"
                           HorizontalAlignment="Left" />
                <Button HorizontalAlignment="Right" Style="{StaticResource GcButton.Primary}"
                        Command="{Binding ScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="14" Height="14" Stretch="Uniform"
                              Data="{StaticResource Icon.Play}"
                              Fill="Transparent"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.75"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <TextBlock Text="开始扫描" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
