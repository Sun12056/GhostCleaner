<UserControl x:Class="GhostCleaner.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:PathToFileNameConverter x:Key="ToFileName" />
        <conv:QuarantineStatusConverter x:Key="StatusConv" />
        <conv:IntToVisibilityConverter x:Key="IntToVisibility" />
        <conv:FileSizeConverter x:Key="SizeFormatter" />
    </UserControl.Resources>

    <StackPanel>

        <!-- 页面标题 -->
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="隔离区" Style="{StaticResource GcPageTitle}" />
                <TextBlock Text="被隔离的目录仍然完好保存在这里，可以随时恢复到原始路径。"
                           Style="{StaticResource GcPageSub}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource GcIconButton}" HorizontalAlignment="Right"
                    Command="{Binding RefreshCommand}" ToolTip="刷新">
                <Path Width="16" Height="16" Stretch="Uniform"
                      Data="{StaticResource Icon.Refresh}"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
        </Grid>

        <!-- 度量组 -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="隔离条目" Style="{StaticResource GcOverline}" />
                    <TextBlock Text="{Binding EntryCount}" Style="{StaticResource GcMetric}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="占用空间" Style="{StaticResource GcOverline}" />
                    <TextBlock Text="{Binding TotalSize, Converter={StaticResource SizeFormatter}}"
                               Style="{StaticResource GcMetric}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="最早到期" Style="{StaticResource GcOverline}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding EarliestExpireText}" Style="{StaticResource GcMetric}" />
                        <TextBlock Text="天后" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,0,4"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding EarliestExpireDateText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 表格 -->
        <Border Style="{StaticResource GcCard.Flush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 卡片头 + 操作 -->
                <Grid Grid.Row="0" Margin="16,12" MinHeight="32">
                    <TextBlock Text="条目" Style="{StaticResource GcH3}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GcButton.SM}" Margin="0,0,8,0"
                                Command="{Binding RestoreCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="{StaticResource Icon.Restore}"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="恢复所选" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GcButton.DangerSubtle.SM}" Margin="0,0,8,0"
                                Command="{Binding DeleteCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Stretch="Uniform"
                                      Data="{StaticResource Icon.Trash}"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="永久删除" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GcButton.Subtle.SM}" Margin="0,0,8,0"
                                Content="清理过期" Command="{Binding PurgeExpiredCommand}" />
                        <Button Style="{StaticResource GcButton.Subtle.SM}"
                                Content="导出清单" Command="{Binding ExportCommand}" />
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Style="{StaticResource GcSeparator}" />

                <!-- 列表 -->
                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          MaxHeight="520"
                          Style="{StaticResource GcDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Width="160" Binding="{Binding OriginalPath, Converter={StaticResource ToFileName}}" />
                        <DataGridTextColumn Header="原始路径" Width="*" Binding="{Binding OriginalPath}" ElementStyle="{StaticResource GcCellPath}" />
                        <DataGridTextColumn Header="大小" Width="110" Binding="{Binding SizeBytes, Converter={StaticResource SizeFormatter}}" ElementStyle="{StaticResource GcCellNumber}" />
                        <DataGridTextColumn Header="隔离时间" Width="160" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" ElementStyle="{StaticResource GcCellNumber}" />
                        <DataGridTextColumn Header="到期" Width="120" Binding="{Binding ExpireAt, StringFormat=yyyy-MM-dd}" ElementStyle="{StaticResource GcCellNumber}" />

                        <DataGridTemplateColumn Header="状态" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GcBadge}" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusConv}, ConverterParameter=bg}"
                                            BorderBrush="{Binding Status, Converter={StaticResource StatusConv}, ConverterParameter=border}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusConv}, ConverterParameter=text}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusConv}, ConverterParameter=fg}"
                                                   Style="{StaticResource GcBadgeText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="操作" Width="72">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource GcIconButton.SM}"
                                            Command="{Binding DataContext.OpenQuarantineFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="打开隔离区目录">
                                        <Path Width="16" Height="16" Stretch="Uniform"
                                              Data="{StaticResource Icon.FolderOpen}"
                                              Fill="Transparent"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.75"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 脚注 -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="隔离区目录：" Style="{StaticResource GcCaption}" />
                            <TextBlock Text="{Binding QuarantineRootText}" Style="{StaticResource GcMono}" />
                            <TextBlock Text="· 过期条目不会自动删除，需手动清理。" Style="{StaticResource GcCaption}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Text.Tertiary}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 空态 -->
        <Border Style="{StaticResource GcCard}"
                Visibility="{Binding EntryCount, Converter={StaticResource IntToVisibility}, ConverterParameter=inverse}">
            <StackPanel HorizontalAlignment="Center" Margin="0,24">
                <Path Width="48" Height="48" Stretch="Uniform"
                      Data="{StaticResource Icon.Quarantine}"
                      Fill="Transparent"
                      Stroke="{DynamicResource Brush.Text.Tertiary}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      HorizontalAlignment="Center" />
                <TextBlock Text="隔离区是空的" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="被隔离的目录会暂时存放在这里，可随时恢复。"
                           Style="{StaticResource GcBody.Secondary}" Margin="0,4,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
