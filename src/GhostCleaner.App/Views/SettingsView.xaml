<UserControl x:Class="GhostCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:EnumToVisibilityConverter x:Key="SectionVisible" />

        <!-- 主题三选一卡片 -->
        <Style x:Key="ThemeOption" TargetType="ToggleButton">
            <Setter Property="Width" Value="76" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource Brush.Bg.Surface}"
                                BorderBrush="{DynamicResource Brush.Border.Default}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.SM}"
                                Padding="8"
                                SnapsToDevicePixels="True">
                            <StackPanel>
                                <Path Width="24" Height="24" Stretch="Uniform"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource Brush.Text.Secondary}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Accent.Bg}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签（白名单关键词 / 排除路径） -->
        <Style x:Key="Tag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Bg.Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.XS}" />
            <Setter Property="Padding" Value="8,0,4,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- 页面标题 -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="设置" Style="{StaticResource GcPageTitle}" />
            <TextBlock Text="调整判定规则、保护范围与外观。修改会立即保存。"
                       Style="{StaticResource GcPageSub}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 分区导航 -->
            <ListBox Grid.Column="0"
                     Style="{StaticResource GcSettingsNavListBox}"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                     AutomationProperties.Name="设置分区" />

            <!-- 分区内容 -->
            <Grid Grid.Column="2">

                <!-- ============ 常规 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=常规}">
                    <StackPanel>
                        <TextBlock Text="常规" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="默认清理动作" FontWeight="SemiBold" />
                                <TextBlock Text="永远不会被自动执行，只是操作栏里的默认值。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" Width="220"
                                      ItemsSource="{Binding CleanActionNames}"
                                      SelectedIndex="{Binding DefaultCleanActionIndex}" />
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="清理前创建系统还原点" FontWeight="SemiBold" />
                                <TextBlock Text="依赖 Windows 系统保护已启用；失败不阻断清理。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource GcSwitch}"
                                          IsChecked="{Binding CreateRestorePoint}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 扫描 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=扫描}">
                    <StackPanel>
                        <TextBlock Text="扫描" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="最大扫描层级" FontWeight="SemiBold" />
                                <TextBlock Text="层级越深越慢，但能发现嵌套更深的安装目录。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" Width="220" SelectedIndex="{Binding MaxScanDepthIndex}">
                                <ComboBoxItem Content="1 层" />
                                <ComboBoxItem Content="2 层（推荐）" />
                                <ComboBoxItem Content="3 层" />
                                <ComboBoxItem Content="4 层" />
                            </ComboBox>
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="包含隐藏目录" FontWeight="SemiBold" />
                                <TextBlock Text="开启后会扫描隐藏目录，但系统关键路径仍会被硬保护。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource GcSwitch}"
                                          IsChecked="{Binding IncludeHiddenDirectories}" />
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="软件判定阈值" FontWeight="SemiBold" />
                                <TextBlock Text="软件特征分低于该值的目录不会被当作软件目录。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" Width="220" SelectedIndex="{Binding MinSoftwareScoreIndex}">
                                <ComboBoxItem Content="20（宽松）" />
                                <ComboBoxItem Content="35" />
                                <ComboBoxItem Content="50（推荐）" />
                                <ComboBoxItem Content="70（严格）" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 保护与白名单 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=保护与白名单}">
                    <StackPanel>
                        <TextBlock Text="保护与白名单" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="允许处理高风险条目" FontWeight="SemiBold" />
                                <TextBlock Text="关闭时，高风险条目会被自动跳过并记入日志。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ToggleButton HorizontalAlignment="Right" Style="{StaticResource GcSwitch}"
                                          IsChecked="{Binding AllowHighRiskClean}" />
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="系统关键路径硬保护" FontWeight="SemiBold" />
                                <TextBlock Text="Windows / System32 / ProgramData / AppData / Users 等路径在任何入口都会被拒绝处理。不可关闭。"
                                           Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource GcBadge.Success}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Data="{StaticResource Icon.Lock}"
                                          Fill="Transparent"
                                          Stroke="{DynamicResource Brush.Success.Fg}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Text="始终开启" Style="{StaticResource GcBadgeText.Success}" Margin="4,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <StackPanel Margin="0,16,0,16">
                            <TextBlock Text="排除路径" FontWeight="SemiBold" />
                            <TextBlock Text="这些路径及其子目录永不参与任何删除操作。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />

                            <ItemsControl ItemsSource="{Binding ExcludedPaths}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tag}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <Button Style="{StaticResource GcIconButton.SM}" Width="20" Height="20"
                                                        Command="{Binding DataContext.RemoveExcludedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="移除">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Data="{StaticResource Icon.Close}"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <TextBox Style="{StaticResource GcTextBox}" Height="32"
                                         Text="{Binding NewExcludedPath, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                                <Button Style="{StaticResource GcButton.SM}" HorizontalAlignment="Right"
                                        Content="添加" Command="{Binding AddExcludedPathCommand}" Margin="0,2,2,2" />
                            </Grid>
                        </StackPanel>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <StackPanel Margin="0,16,0,16">
                            <TextBlock Text="保留关键词" FontWeight="SemiBold" />
                            <TextBlock Text="路径任意层级包含这些关键词即被排除。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />

                            <ItemsControl ItemsSource="{Binding KeepKeywords}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tag}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                <Button Style="{StaticResource GcIconButton.SM}" Width="20" Height="20"
                                                        Command="{Binding DataContext.RemoveKeywordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="移除">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Data="{StaticResource Icon.Close}"
                                                          Fill="Transparent"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="2"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,4,0,0">
                                <TextBox Style="{StaticResource GcTextBox}" Height="32"
                                         Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center" />
                                <Button Style="{StaticResource GcButton.SM}" HorizontalAlignment="Right"
                                        Content="添加" Command="{Binding AddKeywordCommand}" Margin="0,2,2,2" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ 隔离区 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=隔离区}">
                    <StackPanel>
                        <TextBlock Text="隔离区" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="隔离区目录" FontWeight="SemiBold" />
                                <TextBlock Text="默认自动选择剩余空间最大的非系统盘。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Width="220">
                                <TextBox Width="176" Style="{StaticResource GcTextBox}"
                                         Text="{Binding QuarantineRoot, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource Font.Mono}" FontSize="12" />
                                <Button Style="{StaticResource GcIconButton.Bordered}" Margin="8,0,0,0"
                                        Command="{Binding BrowseQuarantineCommand}" ToolTip="选择目录">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Data="{StaticResource Icon.FolderOpen}"
                                          Fill="Transparent"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.75"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="保留天数" FontWeight="SemiBold" />
                                <TextBlock Text="7 ~ 30 天。到期不会自动删除，需手动清理。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ComboBox HorizontalAlignment="Right" Width="220" SelectedIndex="{Binding RetentionDaysIndex}">
                                <ComboBoxItem Content="7 天" />
                                <ComboBoxItem Content="15 天" />
                                <ComboBoxItem Content="30 天" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 外观 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=外观}">
                    <StackPanel>
                        <TextBlock Text="外观" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="主题模式" FontWeight="SemiBold" />
                                <TextBlock Text="Light 与 Dark 使用同一套 Design Token，不是简单反色。切换即时生效。"
                                           Style="{StaticResource GcCaption}" Margin="0,4,0,0" MaxWidth="520" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ToggleButton Style="{StaticResource ThemeOption}" Content="跟随系统"
                                              Tag="{StaticResource Icon.Monitor}"
                                              IsChecked="{Binding ThemeModeSystem, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource ThemeOption}" Content="浅色" Margin="8,0,0,0"
                                              Tag="{StaticResource Icon.Sun}"
                                              IsChecked="{Binding ThemeModeLight, Mode=TwoWay}" />
                                <ToggleButton Style="{StaticResource ThemeOption}" Content="深色" Margin="8,0,0,0"
                                              Tag="{StaticResource Icon.Moon}"
                                              IsChecked="{Binding ThemeModeDark, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 高级 ============ -->
                <Border Style="{StaticResource GcCard}"
                        Visibility="{Binding SelectedSection, Converter={StaticResource SectionVisible}, ConverterParameter=高级}">
                    <StackPanel>
                        <TextBlock Text="高级" Style="{StaticResource GcH3}" Margin="0,0,0,12" />
                        <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="日志与配置目录" FontWeight="SemiBold" />
                                <TextBlock Text="按天写入 JSONL，可在扫描记录中查看。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource GcButton.SM}"
                                    Content="打开目录" Command="{Binding OpenDataFolderCommand}" />
                        </Grid>
                        <Separator Style="{StaticResource GcSeparator}" />

                        <Grid Margin="0,16,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="恢复默认设置" FontWeight="SemiBold" />
                                <TextBlock Text="不会删除隔离区内容与白名单。" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right" Style="{StaticResource GcButton.DangerSubtle.SM}"
                                    Content="恢复默认" Command="{Binding ResetDefaultsCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource GcCaption}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
