<UserControl x:Class="GhostCleaner.App.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             xmlns:svc="clr-namespace:GhostCleaner.App.Services"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:ToastLevelToBrushConverter x:Key="LevelBrush" />
        <conv:ToastLevelToIconConverter x:Key="LevelIcon" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!--
      ⚠️ 容器必须穿透点击：Toast 覆盖在整窗之上，若容器接收命中测试，
      会把下方所有页面交互全部挡死。只有卡片本身可点击（GcToastCard 里 IsHitTestVisible=True）。
    -->
    <Grid IsHitTestVisible="False">
        <ItemsControl ItemsSource="{Binding Items}"
                      Margin="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:ToastNotification}">
                    <Border Style="{StaticResource GcToastCard}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标是描边型（见 IconSet），所以用 Stroke 而非 Fill -->
                            <Path Grid.Column="0"
                                  Width="16" Height="16" Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  Data="{Binding Level, Converter={StaticResource LevelIcon}}"
                                  Fill="Transparent"
                                  Stroke="{Binding Level, Converter={StaticResource LevelBrush}}"
                                  StrokeThickness="1.75"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                            <TextBlock Grid.Column="1"
                                       Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource Brush.Text.Primary}" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource GcToastAction}"
                                    Content="{Binding ActionText}"
                                    Command="{Binding InvokeActionCommand}"
                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                                    VerticalAlignment="Center"
                                    Margin="10,0,2,0" />

                            <Button Grid.Column="3"
                                    Style="{StaticResource GcToastClose}"
                                    Command="{Binding DismissCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
