<Window x:Class="GhostCleaner.App.Views.ProtectedConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="受保护内容确认"
        Width="560" Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource Brush.TextPrimary}" />
        </ScrollViewer>

        <!-- 必须勾选后才允许提交 -->
        <CheckBox Grid.Row="1" x:Name="AckBox" Margin="0,14,0,0"
                  FontSize="12.5" Checked="OnAckChanged" Unchecked="OnAckChanged">
            <TextBlock x:Name="AckText" TextWrapping="Wrap" MaxWidth="470"
                       Foreground="{StaticResource Brush.TextSecondary}" />
        </CheckBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Width="90" IsCancel="True" />
            <Button x:Name="OkButton" Content="确认继续" Style="{StaticResource DangerButton}"
                    Width="110" IsEnabled="False" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
