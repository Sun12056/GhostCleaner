<UserControl x:Class="GhostCleaner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GhostCleaner.App.Converters"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:IntToVisibilityConverter x:Key="IntToVisibility" />
    </UserControl.Resources>

    <StackPanel>

        <!-- ============ 页面标题 ============ -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="概览" Style="{StaticResource GcPageTitle}" />
                <TextBlock Text="GhostCleaner 只做检测。所有结论都需要你确认后才会处理。"
                           Style="{StaticResource GcPageSub}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource GcIconButton}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="刷新"
                    AutomationProperties.Name="刷新">
                <Path Width="16" Height="16" Stretch="Uniform"
                      Data="{StaticResource Icon.Refresh}"
                      Fill="Transparent"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
        </Grid>

        <!-- ============ 权限提示（非阻断） ============ -->
        <Border Style="{StaticResource GcBanner}"
                Margin="0,0,0,24"
                Visibility="{Binding HasElevationRisk, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0"
                      VerticalAlignment="Top"
                      Data="{StaticResource Icon.AlertTriangle}"
                      Fill="Transparent"
                      Stroke="{DynamicResource Brush.Warning}"
                      StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="未以管理员身份运行" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.Warning.Fg}" />
                    <TextBlock Text="{Binding ElevationWarningText}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource GcButton.SM}" VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        Content="以管理员身份重启" Command="{Binding RestartAsAdminCommand}" />
            </Grid>
        </Border>

        <!-- ============ Hero ============ -->
        <Border Style="{StaticResource GcCard}" Padding="32" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                    <TextBlock Text="发现 Windows 忘记的软件残留。"
                               FontFamily="{StaticResource Font.UI}"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}" />
                    <TextBlock Text="扫描各个盘上的旧软件目录，从 9 类来源逐个查证 Windows 是否还记得它们，然后把判断依据摊开给你看。"
                               Style="{StaticResource GcBody.Secondary}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource GcButton.Primary.LG}"
                        VerticalAlignment="Center"
                        Command="{Binding GoToScanCommand}"
                        Content="开始扫描" />
            </Grid>
        </Border>

        <!-- ============ 度量组 ============ -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="上次扫描" Style="{StaticResource GcOverline}" />
                    <TextBlock Text="{Binding LastScanText}" Style="{StaticResource GcMetric}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding LastScanSubText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="未发现系统关联" Style="{StaticResource GcOverline}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding OrphanCountText}" Style="{StaticResource GcMetric}" />
                        <TextBlock Text="项目录" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,0,4"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding OrphanSubText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="预计可释放" Style="{StaticResource GcOverline}" />
                    <TextBlock Text="{Binding TotalSizeText}" Style="{StaticResource GcMetric}" Margin="0,8,0,0"
                               ToolTip="仅统计未排除条目的目录体积；实际释放多少取决于你的选择。" />
                    <TextBlock Text="{Binding TotalSizeSubText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource GcCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="隔离区" Style="{StaticResource GcOverline}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding QuarantineCountText}" Style="{StaticResource GcMetric}" />
                        <TextBlock Text="项" FontSize="13" VerticalAlignment="Bottom" Margin="4,0,0,4"
                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding QuarantineSubText}" Style="{StaticResource GcCaption}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 最近一次扫描 ============ -->
        <Border Style="{StaticResource GcCard}" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="最近一次扫描" Style="{StaticResource GcH3}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Style="{StaticResource GcBadge}" Margin="0,0,8,0"
                                Visibility="{Binding HasPreviousScan, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding LastScanRootsText}" Style="{StaticResource GcBadgeText}" />
                        </Border>
                        <Button Style="{StaticResource GcButton.SM}"
                                Content="查看结果"
                                Command="{Binding GoToResultsCommand}" />
                    </StackPanel>
                </Grid>

                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,12" />

                <TextBlock Text="{Binding LastScanSummaryText}"
                           Style="{StaticResource GcBody.Secondary}" />
            </StackPanel>
        </Border>

        <!-- ============ 最近操作 ============ -->
        <Border Style="{StaticResource GcCard}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBlock Text="最近操作" Style="{StaticResource GcH3}" VerticalAlignment="Center" />
                </Grid>

                <Separator Style="{StaticResource GcSeparator}" Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding RecentLogs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="12"
                                           FontFamily="{StaticResource Font.Mono}"
                                           Foreground="{DynamicResource Brush.Text.Tertiary}"
                                           Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                <TextBlock Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           Text="{Binding Message}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="还没有任何操作记录。"
                           Style="{StaticResource GcCaption}"
                           Margin="0,8,0,0"
                           Visibility="{Binding RecentLogs.Count, Converter={StaticResource IntToVisibility}, ConverterParameter=inverse}" />
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
