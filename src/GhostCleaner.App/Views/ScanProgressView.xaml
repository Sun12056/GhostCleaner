<UserControl x:Class="GhostCleaner.App.Views.ScanProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True">

    <StackPanel Margin="0,24,0,0">

        <!-- 进度环（UDR-03 未就绪时退化为不确定进度，环内显示已检查数量） -->
        <ProgressBar Style="{StaticResource GcScanRing}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Value="{Binding ProgressValue}"
                     HorizontalAlignment="Center" />

        <TextBlock Text="正在扫描" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,0"
                   HorizontalAlignment="Center" />

        <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource GcMono}" Margin="0,8,0,0"
                   MaxWidth="520" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" />

        <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Style="{StaticResource GcCaption}">
            <Run Text="已用 " />
            <Run Text="{Binding ElapsedText, Mode=OneWay}" />
        </TextBlock>

        <!-- 统计组 -->
        <Grid Margin="0,32,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" MinWidth="120">
                <TextBlock Text="{Binding ScannedDirectories}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="已检查目录" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" MinWidth="120">
                <TextBlock Text="{Binding CandidateCount}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="发现候选" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="4" MinWidth="120">
                <TextBlock Text="{Binding OrphanCountText}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="未检测到使用迹象" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="6" MinWidth="120">
                <TextBlock Text="{Binding ElapsedText}" FontSize="24" FontWeight="SemiBold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="已用时间" Style="{StaticResource GcCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- 细进度条（不确定） -->
        <ProgressBar Style="{StaticResource GcProgressBar}" Width="420" Margin="0,24,0,0"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Value="{Binding ProgressValue}" />

        <!-- 操作 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,32,0,0">
            <Button Style="{StaticResource GcButton}" Command="{Binding StopCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="14" Stretch="Uniform"
                          Data="{StaticResource Icon.Stop}"
                          Fill="Transparent"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.75"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    <TextBlock Text="取消" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 降级说明 -->
        <Border Style="{StaticResource GcBanner.Info}" Margin="0,32,0,0" MaxWidth="620">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Margin="0,2,12,0" VerticalAlignment="Top"
                      Data="{StaticResource Icon.Info}"
                      Fill="Transparent" Stroke="{DynamicResource Brush.Accent.Fg}" StrokeThickness="1.75"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="进度显示已降级" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource Brush.Accent.Fg}" />
                    <TextBlock Text="Core 尚未提供扫描总量（UDR-03）与阶段信息（UDR-05），也未提供暂停（UDR-01），因此这里不显示百分比、步骤条与暂停按钮，只显示已检查数量与当前路径。"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
