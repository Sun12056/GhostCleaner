<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础配色 -->
    <SolidColorBrush x:Key="Brush.WindowBackground" Color="#F4F6F9" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="#1F2937" />
    <SolidColorBrush x:Key="Brush.SidebarForeground" Color="#D1D5DB" />
    <SolidColorBrush x:Key="Brush.SidebarActive" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B7280" />

    <SolidColorBrush x:Key="Brush.Primary" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="#B91C1C" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.Success" Color="#16A34A" />

    <!-- 风险等级颜色 -->
    <SolidColorBrush x:Key="Brush.RiskLow" Color="#16A34A" />
    <SolidColorBrush x:Key="Brush.RiskMedium" Color="#D97706" />
    <SolidColorBrush x:Key="Brush.RiskHigh" Color="#DC2626" />
</ResourceDictionary>
