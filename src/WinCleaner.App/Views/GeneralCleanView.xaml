<UserControl x:Class="WinCleaner.App.Views.GeneralCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="常规清理" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusText}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="开始扫描" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
                    <Button Content="清理所选项" Style="{StaticResource WarningButton}" Command="{Binding CleanCommand}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                               Text="{Binding SelectedSummary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="可清理项目" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="6" Padding="10" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding Result.Name, Mode=OneWay}" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Result.SizeText, Mode=OneWay}" />
                                            <Run Text="（" />
                                            <Run Text="{Binding Result.FileCount, Mode=OneWay}" />
                                            <Run Text=" 个文件）" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Result.Description, Mode=OneWay}" />
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding Result.Path, Mode=OneWay}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="打开目录" Style="{StaticResource BaseButton}"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                           Text="说明：被占用的文件会自动跳过；Windows 更新缓存删除后系统会在需要时重新下载。此功能为基础实现，回收站清理、浏览器缓存等后续版本提供。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
