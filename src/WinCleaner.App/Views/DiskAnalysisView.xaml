<UserControl x:Class="WinCleaner.App.Views.DiskAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="磁盘分析" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="磁盘：" VerticalAlignment="Center" />
                    <ComboBox Width="260" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                              DisplayMemberPath="Display" />
                    <TextBlock Text="最小大小：" VerticalAlignment="Center" Margin="16,0,0,0" />
                    <ComboBox Width="120" SelectedValue="{Binding MinSizeBytes}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="50 MB" Tag="52428800" />
                        <ComboBoxItem Content="100 MB" Tag="104857600" IsSelected="True" />
                        <ComboBoxItem Content="500 MB" Tag="524288000" />
                        <ComboBoxItem Content="1 GB" Tag="1073741824" />
                    </ComboBox>
                    <Button Content="扫描大文件" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
                </StackPanel>

                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding StatusText}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Margin="0,0,0,8">
                    <Run Text="大文件列表（合计 " />
                    <Run Text="{Binding TotalText, Mode=OneWay}" />
                    <Run Text="）" />
                </TextBlock>

                <DataGrid ItemsSource="{Binding Files}"
                          SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                          MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="100" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="620" />
                        <DataGridTextColumn Header="类型" Binding="{Binding Extension}" Width="80" />
                        <DataGridTextColumn Header="最后修改" Binding="{Binding LastModifiedText}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="打开文件位置" Style="{StaticResource BaseButton}" Command="{Binding OpenFileLocationCommand}" />
                    <Button Content="删除到回收站" Style="{StaticResource DangerButton}" Command="{Binding DeleteToRecycleBinCommand}" />
                </StackPanel>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                           Text="删除前请确认文件用途：视频、镜像、工程文件等体积大但可能是重要资料。删除到回收站后仍可从回收站还原。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
