<Window x:Class="WinCleaner.App.Views.ConfirmTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="危险操作确认"
        Width="520" Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.WindowBackground}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Brush.TextPrimary}" />
        </ScrollViewer>

        <TextBlock Grid.Row="1" Margin="0,12,0,4" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}">
            请输入 <Run x:Name="ExpectedRun" FontWeight="Bold" Foreground="{StaticResource Brush.Danger}" /> 以确认执行：
        </TextBlock>

        <TextBox Grid.Row="2" x:Name="InputBox" FontSize="13" Padding="6,5" TextChanged="OnInputChanged" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource BaseButton}" Width="90" IsCancel="True" />
            <Button x:Name="OkButton" Content="确认执行" Style="{StaticResource DangerButton}" Width="110" IsEnabled="False" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
