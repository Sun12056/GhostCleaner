<UserControl x:Class="WinCleaner.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- 隔离区 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="隔离区" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="隔离区目录：" VerticalAlignment="Center" Width="110" />
                    <TextBox Width="360" Text="{Binding QuarantineRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="浏览…" Style="{StaticResource BaseButton}" Command="{Binding BrowseQuarantineCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="保留天数：" VerticalAlignment="Center" Width="110" />
                    <Slider Width="240" Minimum="7" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding RetentionDays}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding RetentionDays}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="（7 ~ 30 天，过期可手动或自动清理）" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource HintText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="默认动作：" VerticalAlignment="Center" Width="110" />
                    <ComboBox Width="160" ItemsSource="{Binding CleanActionNames}"
                              SelectedIndex="{Binding DefaultCleanActionIndex}" />
                    <TextBlock Text="（仅作为默认值，任何操作都需人工确认）" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource HintText}" />
                </StackPanel>

                <CheckBox Margin="0,10,0,0" Content="清理前尝试创建系统还原点"
                          IsChecked="{Binding CreateRestorePoint}" />
                <CheckBox Margin="0,6,0,0" Content="允许处理高风险条目（不推荐，可能导致系统或用户数据受损）"
                          IsChecked="{Binding AllowHighRiskClean}"
                          Foreground="{StaticResource Brush.Danger}" />
            </StackPanel>
        </Border>

        <!-- 扫描参数 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="扫描参数" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="最大扫描层级：" VerticalAlignment="Center" Width="110" />
                    <ComboBox Width="120" SelectedValue="{Binding MaxScanDepth}" SelectedValuePath="Content">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                    <TextBlock Text="（2 层可覆盖 D:\ 与 D:\Program Files\软件名）" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource HintText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="软件判定阈值：" VerticalAlignment="Center" Width="110" />
                    <Slider Width="240" Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                            Value="{Binding MinSoftwareScore}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding MinSoftwareScore}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold" />
                    <TextBlock Text="（分值越高越保守，只有更像软件目录才会被列出）" VerticalAlignment="Center" Margin="10,0,0,0"
                               Style="{StaticResource HintText}" />
                </StackPanel>

                <CheckBox Margin="0,10,0,0" Content="扫描隐藏目录" IsChecked="{Binding IncludeHiddenDirectories}" />
            </StackPanel>
        </Border>

        <!-- 白名单 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="白名单：排除路径" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="360" Text="{Binding NewExcludedPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="添加" Style="{StaticResource BaseButton}" Command="{Binding AddExcludedPathCommand}" />
                    <Button Content="浏览…" Style="{StaticResource BaseButton}" Command="{Binding BrowseExcludedPathCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding ExcludedPaths}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,4" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Content="移除" Style="{StaticResource BaseButton}" Padding="8,2" Margin="12,0,0,0" MinWidth="0"
                                            Command="{Binding DataContext.RemoveExcludedPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 保留关键词 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="白名单：保留关键词" Margin="0,0,0,8" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="路径任意层级包含这些关键词的目录都不会被删除（例如 SteamLibrary、Epic、工作、项目）。" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBox Width="260" Text="{Binding NewKeyword, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="添加关键词" Style="{StaticResource BaseButton}" Command="{Binding AddKeywordCommand}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding KeepKeywords}" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="4" Padding="8,4" Margin="0,2,6,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Content="×" Style="{StaticResource BaseButton}" Padding="6,1" Margin="8,0,0,0" MinWidth="0"
                                            Command="{Binding DataContext.RemoveKeywordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 保存 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                    <Button Content="恢复默认" Style="{StaticResource BaseButton}" Command="{Binding ResetDefaultsCommand}" />
                    <Button Content="打开数据目录" Style="{StaticResource BaseButton}" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="{Binding StatusText}" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                    <Run Text="配置文件：" />
                    <Run Text="{Binding SettingsFilePath, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
