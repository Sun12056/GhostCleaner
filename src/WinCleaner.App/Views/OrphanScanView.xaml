<UserControl x:Class="WinCleaner.App.Views.OrphanScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinCleaner.App.ViewModels"
             xmlns:conv="clr-namespace:WinCleaner.App.Converters"
             xmlns:models="clr-namespace:WinCleaner.Core.Models;assembly=WinCleaner.Core">
    <UserControl.Resources>
        <conv:RiskToBrushConverter x:Key="RiskToBrush" />
        <conv:ConfidenceToBrushConverter x:Key="ConfidenceToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <!-- 扫描范围 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="扫描范围" Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Display}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,4,18,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                    <TextBlock Text="自定义目录：" VerticalAlignment="Center" />
                    <TextBox Width="320" Text="{Binding CustomDirectoryInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="添加" Style="{StaticResource BaseButton}"
                            Command="{Binding AddInputDirectoryCommand}" />
                    <Button Content="浏览…" Style="{StaticResource BaseButton}"
                            Command="{Binding AddCustomDirectoryCommand}" />
                    <Button Content="添加所选盘的常见安装目录" Style="{StaticResource BaseButton}"
                            Command="{Binding AddCommonDirectoriesCommand}"
                            ToolTip="自动添加 Program Files / Software / Games / Tools / GreenSoft 等存在目录" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding CustomDirectories}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9FAFB" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                    <Button Content="移除" Style="{StaticResource BaseButton}"
                                            Padding="8,2" Margin="12,0,0,0" MinWidth="0"
                                            Command="{Binding DataContext.RemoveCustomDirectoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 操作栏 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="开始扫描" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanCommand}" />
                    <Button Content="停止" Style="{StaticResource BaseButton}"
                            Command="{Binding StopCommand}" />
                    <Button Content="全选" Style="{StaticResource BaseButton}"
                            Command="{Binding SelectAllCommand}" />
                    <Button Content="反选" Style="{StaticResource BaseButton}"
                            Command="{Binding InvertSelectionCommand}" />
                    <Button Content="取消勾选" Style="{StaticResource BaseButton}"
                            Command="{Binding SelectNoneCommand}" />
                    <Button Content="仅勾选低风险" Style="{StaticResource BaseButton}"
                            Command="{Binding SelectLowRiskOnlyCommand}" />
                    <Button Content="导出报告" Style="{StaticResource BaseButton}"
                            Command="{Binding ExportCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="风险筛选：" VerticalAlignment="Center" />
                    <ComboBox Width="120" SelectedItem="{Binding RiskFilter}">
                        <ComboBox.ItemsSource>
                            <x:Array Type="vm:RiskFilterOption">
                                <vm:RiskFilterOption>All</vm:RiskFilterOption>
                                <vm:RiskFilterOption>Low</vm:RiskFilterOption>
                                <vm:RiskFilterOption>Medium</vm:RiskFilterOption>
                                <vm:RiskFilterOption>High</vm:RiskFilterOption>
                            </x:Array>
                        </ComboBox.ItemsSource>
                    </ComboBox>
                    <TextBox Width="220" Margin="12,0,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按路径或软件名搜索" />
                    <CheckBox Content="显示已排除条目" Margin="12,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding ShowExcluded}" />
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding SelectedSummary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}">
                        <Run Text="结果：" />
                        <Run Text="{Binding ResultCount, Mode=OneWay}" />
                        <Run Text=" 项 ｜ 高风险 " />
                        <Run Text="{Binding HighRiskCount, Mode=OneWay}" />
                        <Run Text=" ｜ 中风险 " />
                        <Run Text="{Binding MediumRiskCount, Mode=OneWay}" />
                        <Run Text=" ｜ 低风险 " />
                        <Run Text="{Binding LowRiskCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Brush.TextSecondary}">
                        <Run Text="疑似残留度：高概率 " />
                        <Run Text="{Binding HighConfidenceCount, Mode=OneWay}" />
                        <Run Text=" ｜ 需人工确认 " />
                        <Run Text="{Binding ReviewCount, Mode=OneWay}" />
                        <Run Text=" ｜ 受保护/已排除 " />
                        <Run Text="{Binding ProtectedCount, Mode=OneWay}" />
                        <Run Text=" ｜ 带警告 " />
                        <Run Text="{Binding WarningCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <!-- 扫描不完整警告 -->
                <Border Margin="0,10,0,0" Padding="10,6" Background="#FFF7ED" BorderBrush="#FDBA74"
                        BorderThickness="1" CornerRadius="4"
                        Visibility="{Binding HasScanWarnings, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#9A3412"
                                   Text="⚠ 扫描结果可能不完整（未完成的检查不会被当作“没有引用”）" />
                        <ItemsControl ItemsSource="{Binding ScanWarnings}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="#9A3412" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}"
                           Text="{Binding ResultSummaryText, Mode=OneWay}" />

                <ProgressBar Height="6" Margin="0,10,0,2" Value="{Binding ProgressValue}" Maximum="100"
                             Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibility}}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <!-- 结果列表 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="扫描结果（疑似软件残留）" Margin="0,0,0,8" />

                <DataGrid ItemsSource="{Binding ResultsView}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          MaxHeight="360"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="46" Header="选择">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsExcluded, Converter={StaticResource InverseBool}}"
                                              HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="82" Header="疑似残留度">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold"
                                               Foreground="{Binding ConfidenceLevel, Converter={StaticResource ConfidenceToBrush}}">
                                        <Run Text="{Binding ConfidenceText, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding ConfidenceLevelText, Mode=OneWay}" FontSize="11" />
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="70" Header="风险">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RiskText}" FontWeight="SemiBold"
                                               Foreground="{Binding Risk, Converter={StaticResource RiskToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="建议" Binding="{Binding RecommendationText}" Width="130" />
                        <DataGridTextColumn Header="推测软件名" Binding="{Binding DisplayName}" Width="150" />
                        <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="330" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="85" />
                        <DataGridTextColumn Header="性质" Binding="{Binding CategoryText}" Width="80" />
                        <DataGridTextColumn Header="最后修改" Binding="{Binding LastModifiedText}" Width="130" />
                        <DataGridTextColumn Header="卸载程序" Binding="{Binding HasUninstaller}" Width="80" />
                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- 详情：解释"为什么" -->
                <Border Margin="0,12,0,0" Padding="12" Background="#F9FAFB"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6"
                        Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" FontSize="14">
                            <Run Text="详情：" />
                            <Run Text="{Binding SelectedItem.DisplayName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}">
                            <Run Text="路径：" />
                            <Run Text="{Binding SelectedItem.Path, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}">
                            <Run Text="版本：" />
                            <Run Text="{Binding SelectedItem.Version, Mode=OneWay}" />
                            <Run Text=" ｜ 厂商：" />
                            <Run Text="{Binding SelectedItem.Publisher, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}">
                            <Run Text="疑似残留度：" />
                            <Run Text="{Binding SelectedItem.ConfidenceText, Mode=OneWay}" />
                            <Run Text="（" />
                            <Run Text="{Binding SelectedItem.ConfidenceLevelText, Mode=OneWay}" />
                            <Run Text="） ｜ 风险：" />
                            <Run Text="{Binding SelectedItem.RiskText, Mode=OneWay}" />
                            <Run Text=" ｜ 建议：" />
                            <Run Text="{Binding SelectedItem.RecommendationText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}">
                            <Run Text="目录性质：" />
                            <Run Text="{Binding SelectedItem.CategoryText, Mode=OneWay}" />
                            <Run Text=" ｜ 保护：" />
                            <Run Text="{Binding SelectedItem.ProtectionText, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="检测依据（为什么怀疑它是残留）" />
                        <ItemsControl ItemsSource="{Binding SelectedItem.PositiveEvidence, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource HintText}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Text="保护提示（为什么不能轻易处理）" />
                        <ItemsControl ItemsSource="{Binding SelectedItem.NegativeEvidence, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Style="{StaticResource HintText}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,10,0,2" FontWeight="SemiBold" Foreground="#9A3412" Text="警告"
                                   Visibility="{Binding SelectedItem.HasWarnings, Converter={StaticResource BooleanToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding SelectedItem.Warnings, Mode=OneWay}"
                                      Visibility="{Binding SelectedItem.HasWarnings, Converter={StaticResource BooleanToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="#9A3412" Style="{StaticResource HintText}">
                                        <Run Text="⚠ " />
                                        <Run Text="{Binding}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}"
                                   Visibility="{Binding SelectedItem.IsExcluded, Converter={StaticResource BooleanToVisibility}}">
                            <Run Text="白名单：" />
                            <Run Text="{Binding SelectedItem.ExcludeReason, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Style="{StaticResource HintText}">
                            <Run Text="主要可执行文件：" />
                            <Run Text="{Binding SelectedItem.MainExecutableText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="移到隔离区（推荐）" Style="{StaticResource PrimaryButton}"
                            Command="{Binding MoveToQuarantineCommand}" />
                    <Button Content="删除到回收站" Style="{StaticResource WarningButton}"
                            Command="{Binding DeleteToRecycleBinCommand}" />
                    <Button Content="强制永久删除" Style="{StaticResource DangerButton}"
                            Command="{Binding PermanentDeleteCommand}" />
                    <Button Content="打开目录" Style="{StaticResource BaseButton}"
                            Command="{Binding OpenSelectedFolderCommand}" />
                    <Button Content="运行其卸载程序" Style="{StaticResource BaseButton}"
                            Command="{Binding RunUninstallerCommand}" />
                    <Button Content="加入白名单" Style="{StaticResource BaseButton}"
                            Command="{Binding AddSelectedToWhitelistCommand}" />
                </StackPanel>

                <TextBlock Margin="0,8,0,0" Style="{StaticResource HintText}" TextWrapping="Wrap"
                           Text="安全说明：扫描只做检测，不会删除任何文件。“疑似残留度”表示 GhostCleaner 有多大把握认为它是残留，不等于可以删除；“风险”表示清理后出问题的代价。默认不勾选任何条目；移到隔离区可恢复；永久删除需要输入确认文字；系统关键目录、白名单目录与受保护内容（用户数据/游戏/开发项目）不会被轻易处理。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
