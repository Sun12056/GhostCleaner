<UserControl x:Class="WinCleaner.App.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="隔离区" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusText}" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0">
                    <Run Text="隔离区目录：" />
                    <Run Text="{Binding QuarantineRootText, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="刷新" Style="{StaticResource BaseButton}" Command="{Binding RefreshCommand}" />
                    <Button Content="恢复所选" Style="{StaticResource PrimaryButton}" Command="{Binding RestoreCommand}" />
                    <Button Content="彻底删除" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                    <Button Content="清理过期条目" Style="{StaticResource WarningButton}" Command="{Binding PurgeExpiredCommand}" />
                    <Button Content="清空隔离区" Style="{StaticResource DangerButton}" Command="{Binding ClearCommand}" />
                    <Button Content="打开隔离区目录" Style="{StaticResource BaseButton}" Command="{Binding OpenQuarantineFolderCommand}" />
                    <Button Content="导出清单" Style="{StaticResource BaseButton}" Command="{Binding ExportCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Summary}" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          MaxHeight="460"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="隔离时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                        <DataGridTextColumn Header="名称" Binding="{Binding DisplayName}" Width="160" />
                        <DataGridTextColumn Header="原始路径" Binding="{Binding OriginalPath}" Width="380" />
                        <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                        <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="80" />
                        <DataGridTextColumn Header="过期时间" Binding="{Binding ExpireAt, StringFormat=yyyy-MM-dd}" Width="110" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="0,10,0,0" Style="{StaticResource HintText}"
                           Text="恢复：把条目移回原始路径（若原路径已存在同名目录会失败）。彻底删除 / 清空隔离区需要输入确认文字，且不可恢复。" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
