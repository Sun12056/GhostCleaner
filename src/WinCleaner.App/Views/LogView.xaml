<UserControl x:Class="WinCleaner.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="操作日志" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding StatusText}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="刷新" Style="{StaticResource BaseButton}" Command="{Binding LoadCommand}" />
                    <Button Content="导出日志" Style="{StaticResource BaseButton}" Command="{Binding ExportCommand}" />
                    <TextBox Width="260" Margin="8,0,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="按路径、操作或说明过滤" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DataGrid ItemsSource="{Binding EntriesView}" MaxHeight="600" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimestampText}" Width="150" />
                    <DataGridTextColumn Header="级别" Binding="{Binding Level}" Width="80" />
                    <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="90" />
                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="120" />
                    <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="360" />
                    <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" Width="90" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" />
                    <DataGridTextColumn Header="说明" Binding="{Binding Message}" Width="320" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
